# ==============================================================================
# Flask Mailer Platform - Environment Configuration Template
# Copy to .env and fill in real values. Never commit the real .env file.
# ==============================================================================

# --- Flask / Application ---
FLASK_ENV=development
FLASK_APP=app:create_app
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
BASE_URL=http://localhost:5000

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Redis (Celery broker + result backend + cache) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Brevo (Sendinblue) ---
BREVO_API_KEY=your-brevo-api-key
# Shared secret for the inbound webhook. Register the webhook URL as:
#   https://YOUR_PUBLIC_BASE_URL/api/webhooks/brevo?token=<this value>
BREVO_WEBHOOK_SECRET=your-brevo-webhook-token

# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Rate limiting ---
# On hosts without Redis (e.g. cPanel) set this to: memory://
RATELIMIT_STORAGE_URI=redis://localhost:6379/2

# --- Sending engine ---
# "celery" (worker + beat, needs Redis) or "cron" (no Redis; driven by
# `python -m app.cron tick` from a system cron job). Use "cron" on cPanel.
SEND_MODE=celery

# --- Authentication (Supabase magic link) ---
# Comma-separated list of emails allowed to sign in. Leave EMPTY to deny all
# logins. Set AUTH_REQUIRED=false only for local development.
AUTH_REQUIRED=true
AUTH_ALLOWED_EMAILS=you@example.com

# Public URL used for tracking + unsubscribe links (must be reachable by
# recipients). Setting this in the DB (Settings page) overrides this value.
PUBLIC_BASE_URL=https://mail.yourdomain.com

# ==============================================================================
# NOTE: rates, caps, sending windows, sender identity, the Brevo plan and
# deliverability thresholds are managed in the app's Settings page (stored in
# the database), NOT here. Keep this file to bootstrap / infra / secrets only.
# ==============================================================================
