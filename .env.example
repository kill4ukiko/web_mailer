# ==============================================================================
# Flask Mailer Platform - Environment Configuration Template
# Copy to .env and fill in real values. Never commit the real .env file.
# ==============================================================================

# --- Flask / Application ---
FLASK_ENV=development
FLASK_APP=app:create_app
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
BASE_URL=http://localhost:5000
# Trust Cloudflare's CF-Connecting-IP header for rate limits and recorded event
# IPs. Enable only when the origin is reachable exclusively through Cloudflare
# or cloudflared; otherwise clients can spoof the header.
TRUST_CLOUDFLARE_CLIENT_IP=false

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Redis (Celery broker + result backend + cache) ---
# Windows/RDP: optional path to redis-server.exe for scripts/run_stack.py.
# REDIS_SERVER=C:\redis\redis-server.exe
# Cache/lookup DB (separate from the Celery broker / backend / limiter).
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Brevo (Sendinblue) ---
BREVO_API_KEY=your-brevo-api-key
# Shared secret for the inbound webhook. Register the webhook URL as:
#   https://YOUR_PUBLIC_BASE_URL/api/webhooks/brevo?token=<this value>
BREVO_WEBHOOK_SECRET=your-brevo-webhook-token

# --- Unsubscribe link signing ---
# Dedicated secret for unsubscribe tokens and click signatures. Rotating
# SECRET_KEY then does not invalidate links in mail that was already sent.
# Leave empty to fall back to SECRET_KEY (single-secret installs).
UNSUBSCRIBE_TOKEN_SECRET=change-me-to-another-long-random-string
# Comma-separated previous secrets; links signed with them keep working.
UNSUBSCRIBE_LEGACY_SECRETS=

# --- Telegram Alerts ---
# Global fallback for all three workspaces. Each workspace can override the
# token/chat independently on its settings page (stored in the database).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Bird SMS (isolated third workspace) ---
# Workspace API key starting with bk_. Leave blank to configure it later in the
# Bird SMS settings page (secrets are stored in the database and masked).
BIRD_API_KEY=
# Optional key with the sms_management scope, used only to browse Bird template slugs.
BIRD_MANAGEMENT_API_KEY=
# us1 or eu1 - must match the Bird workspace region.
BIRD_REGION=us1
# Optional workspace identifier.
BIRD_WORKSPACE_ID=
# webhook signing secret shown when you create the Bird webhook endpoint,
# starting with whsec_. The webhook URL is:
#   https://YOUR_PUBLIC_BASE_URL/api/webhooks/bird
BIRD_WEBHOOK_SECRET=

# --- Rate limiting ---
# On hosts without Redis set this to: memory://
RATELIMIT_STORAGE_URI=redis://localhost:6379/2

# --- Sending engine ---
# "celery" (worker + beat, needs Redis) or "cron" (no Redis; driven by
# `python -m app.cron tick` from a scheduler).
SEND_MODE=celery

# --- Authentication (Supabase magic link) ---
# Comma-separated list of emails allowed to sign in. Leave EMPTY to deny all
# logins. Set AUTH_REQUIRED=false only for local development.
AUTH_REQUIRED=true
AUTH_ALLOWED_EMAILS=you@example.com

# Public URL used for tracking + unsubscribe links (must be reachable by
# recipients). Setting this in the DB (Settings page) overrides this value.
PUBLIC_BASE_URL=https://mail.yourdomain.com

# ==============================================================================
# NOTE: rates, caps, sending windows, sender identity, the Brevo plan and
# deliverability thresholds are managed in the app's Settings page (stored in
# the database), NOT here. Keep this file to bootstrap / infra / secrets only.
# ==============================================================================
